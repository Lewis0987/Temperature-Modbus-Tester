<Window x:Class="ModbusTester.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ModbusTester.App.ViewModels"
        xmlns:models="clr-namespace:ModbusTester.Core.Models;assembly=ModbusTester.Core"
        Title="Modbus Tester" Height="860" Width="1100" MinHeight="600" MinWidth="900"
        FontFamily="Segoe UI" FontSize="13">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4,2" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="6" />
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <!-- ===== Connection ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Connection Type" IsEnabled="{Binding CanEditConnection}">
                <StackPanel>
                    <RadioButton Content="Modbus TCP" Margin="4" IsChecked="{Binding IsTcp}" />
                    <RadioButton Content="Modbus RTU" Margin="4" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Modbus TCP" IsEnabled="{Binding IsTcp}">
                <Grid IsEnabled="{Binding CanEditConnection}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Label Content="IP Address" />
                    <TextBox Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Column="2" Content="Port" />
                    <TextBox Grid.Column="3" Text="{Binding Port}" />
                    <Label Grid.Row="1" Content="Timeout (ms)" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TimeoutMs}" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Modbus RTU">
                <TextBlock Margin="4" Foreground="Gray" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Phase 2: COM Port / Baud / Data Bits / Parity / Stop Bits / Slave ID" />
            </GroupBox>

            <GroupBox Grid.Column="3" Header="Status">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <Ellipse Width="12" Height="12" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="Gray" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static models:ConnectionState.Connecting}">
                                            <Setter Property="Fill" Value="Orange" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static models:ConnectionState.Connected}">
                                            <Setter Property="Fill" Value="LimeGreen" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static models:ConnectionState.Timeout}">
                                            <Setter Property="Fill" Value="OrangeRed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static models:ConnectionState.Error}">
                                            <Setter Property="Fill" Value="Red" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionState}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Connect" Command="{Binding ConnectCommand}" />
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- ===== Request ===== -->
        <GroupBox Grid.Row="1" Header="Register Read">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Label Content="Function" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Functions}" SelectedItem="{Binding SelectedFunction}" />
                <Label Grid.Column="2" Content="Unit ID" />
                <TextBox Grid.Column="3" Text="{Binding UnitId}" />
                <Label Grid.Column="4" Content="Address" />
                <TextBox Grid.Column="5" Text="{Binding StartAddress}" />
                <Label Grid.Column="6" Content="Quantity" />
                <TextBox Grid.Column="7" Text="{Binding Quantity}" />
                <Button Grid.Column="8" Content="Read" HorizontalAlignment="Left" FontWeight="SemiBold"
                        Command="{Binding ReadCommand}" IsDefault="True" />

                <Label Grid.Row="1" Content="Address Base" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AddressBases}" SelectedItem="{Binding SelectedAddressBase}" />
                <Label Grid.Row="1" Grid.Column="2" Content="Scale" />
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding DefaultScale}" />
                <Button Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Content="Apply to all" Command="{Binding ApplyDefaultScaleCommand}" />
                <TextBlock Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="3" Margin="8,2" VerticalAlignment="Center"
                           FontWeight="Bold" Text="{Binding LastResult}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Firebrick" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LastResultPassed}" Value="True">
                                    <Setter Property="Foreground" Value="ForestGreen" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </GroupBox>

        <!-- ===== Result ===== -->
        <GroupBox Grid.Row="2" Header="Registers (Scale column is editable)">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      FontFamily="Consolas">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" IsReadOnly="True" Width="80" />
                    <DataGridTextColumn Header="Raw" Binding="{Binding Raw}" IsReadOnly="True" Width="80" />
                    <DataGridTextColumn Header="Decimal" Binding="{Binding Decimal}" IsReadOnly="True" Width="80" />
                    <DataGridTextColumn Header="HEX" Binding="{Binding Hex}" IsReadOnly="True" Width="70" />
                    <DataGridTextColumn Header="Binary" Binding="{Binding Binary}" IsReadOnly="True" Width="180" />
                    <DataGridTextColumn Header="Scale" Binding="{Binding Scale, UpdateSourceTrigger=LostFocus}" Width="80" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" IsReadOnly="True" Width="*" FontWeight="Bold" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="#DDD" />

        <!-- ===== Log ===== -->
        <GroupBox Grid.Row="4">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Communication Log" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="Clear" Command="{Binding ClearLogCommand}" MinWidth="60" Padding="8,1" />
                    <Button Content="Copy" Command="{Binding CopyLogCommand}" MinWidth="60" Padding="8,1" />
                </StackPanel>
            </GroupBox.Header>
            <ListBox x:Name="LogList" ItemsSource="{Binding LogEntries}" FontFamily="Consolas" FontSize="12"
                     VirtualizingPanel.IsVirtualizing="True" SelectionMode="Extended">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:LogEntry">
                        <TextBlock Text="{Binding}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogKind.Tx}">
                                            <Setter Property="Foreground" Value="RoyalBlue" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogKind.Rx}">
                                            <Setter Property="Foreground" Value="DarkCyan" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogKind.Pass}">
                                            <Setter Property="Foreground" Value="ForestGreen" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogKind.Fail}">
                                            <Setter Property="Foreground" Value="Firebrick" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogKind.Error}">
                                            <Setter Property="Foreground" Value="Firebrick" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
    </Grid>
</Window>
