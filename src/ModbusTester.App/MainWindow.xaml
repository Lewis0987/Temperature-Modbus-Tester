<Window x:Class="ModbusTester.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ModbusTester.App.ViewModels"
        xmlns:controls="clr-namespace:ModbusTester.App.Controls"
        xmlns:models="clr-namespace:ModbusTester.Core.Models;assembly=ModbusTester.Core"
        Title="Modbus Tester" Height="860" Width="1100" MinHeight="600" MinWidth="900"
        FontFamily="Segoe UI" FontSize="13">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Invalid input: WPF's default error template draws the red border (driven by INotifyDataErrorInfo);
             the tooltip shows why. Both clear as soon as the text becomes valid. -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4,2" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="6" />
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <!-- ===== Connection ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Connection Type" IsEnabled="{Binding CanEditConnection}">
                <StackPanel>
                    <RadioButton Content="Modbus TCP" Margin="4" IsChecked="{Binding IsTcp}" />
                    <RadioButton Content="Modbus RTU" Margin="4" IsChecked="{Binding IsRtu}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Modbus TCP" IsEnabled="{Binding IsTcp}">
                <Grid IsEnabled="{Binding CanEditConnection}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Label Content="IP Address" />
                    <!-- IP Address: free text (validated as before) + ▼ input history (IP only, no Port) -->
                    <controls:HistoryField Grid.Column="1" History="{Binding TcpHostHistory}">
                        <TextBox x:Name="HostTextBox" Text="{Binding HostText, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:HistoryField>
                    <Label Grid.Column="2" Content="Port" />
                    <TextBox Grid.Column="3" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Row="1" Content="Unit ID" />
                    <controls:HistoryField Grid.Row="1" Grid.Column="1" History="{Binding TcpUnitIdHistory}">
                        <TextBox Text="{Binding UnitIdText, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:HistoryField>
                    <Label Grid.Row="2" Content="Timeout (ms)" />
                    <controls:HistoryField Grid.Row="2" Grid.Column="1" History="{Binding TcpTimeoutHistory}">
                        <TextBox Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:HistoryField>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Modbus RTU" IsEnabled="{Binding IsRtu}">
                <Grid IsEnabled="{Binding CanEditConnection}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Label Content="COM Port" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ComPorts}" SelectedItem="{Binding SelectedComPort}" />
                    <Button Grid.Column="2" Grid.ColumnSpan="2" Content="Refresh COM" HorizontalAlignment="Left"
                            Command="{Binding RefreshComPortsCommand}" />
                    <Label Grid.Row="1" Content="Baud Rate" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding BaudRate}" />
                    <Label Grid.Row="1" Grid.Column="2" Content="Data Bits" />
                    <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding DataBits}" />
                    <Label Grid.Row="2" Content="Parity" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Parities}" SelectedItem="{Binding SelectedParity}" />
                    <Label Grid.Row="2" Grid.Column="2" Content="Stop Bits" />
                    <ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding SelectedStopBits}" />
                    <Label Grid.Row="3" Content="Slave ID" />
                    <controls:HistoryField Grid.Row="3" Grid.Column="1" History="{Binding RtuSlaveIdHistory}">
                        <TextBox Text="{Binding SlaveIdText, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:HistoryField>
                    <Label Grid.Row="3" Grid.Column="2" Content="Timeout (ms)" />
                    <controls:HistoryField Grid.Row="3" Grid.Column="3" History="{Binding RtuTimeoutHistory}">
                        <TextBox Text="{Binding RtuTimeoutText, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:HistoryField>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="3" Header="Status">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <Ellipse Width="12" Height="12" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="Gray" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static models:ConnectionState.Connecting}">
                                            <Setter Property="Fill" Value="Orange" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static models:ConnectionState.Connected}">
                                            <Setter Property="Fill" Value="LimeGreen" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static models:ConnectionState.Timeout}">
                                            <Setter Property="Fill" Value="OrangeRed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static models:ConnectionState.Error}">
                                            <Setter Property="Fill" Value="Red" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionState}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Connect" Command="{Binding ConnectCommand}" />
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- ===== Request ===== -->
        <GroupBox Grid.Row="1" Header="Register Read" IsEnabled="{Binding HasConnectionType}">
            <!-- Two independent rows; SharedSizeGroup keeps the label/field columns of both rows aligned.
                 Row 1's Quantity columns are Auto, so when Quantity is collapsed (device profile) Read moves left. -->
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid x:Name="ReadRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="RrLabel1" />
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="RrLabel2" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="Function" />
                    <!-- A device profile that prescribes the function (A6V12258321: FC03) fixes and disables it. -->
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Functions}" SelectedItem="{Binding SelectedFunction}"
                              IsEnabled="{Binding IsFunctionSelectable}" />
                    <Label Grid.Column="2" Content="Address"
                           ToolTip="Generic Modbus: start address (with Quantity). Device profile: read every register the profile defines up to this address." />
                    <controls:HistoryField Grid.Column="3" History="{Binding AddressHistory}">
                        <TextBox Text="{Binding StartAddressText, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:HistoryField>
                    <!-- Quantity is a Generic Modbus input only; a device profile decides which registers to read. -->
                    <Label Grid.Column="4" Content="Quantity"
                           Visibility="{Binding IsGenericProfile, Converter={StaticResource BoolToVisibility}}" />
                    <controls:HistoryField Grid.Column="5" Width="80" History="{Binding QuantityHistory}"
                                           Visibility="{Binding IsGenericProfile, Converter={StaticResource BoolToVisibility}}">
                        <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:HistoryField>
                    <Button Grid.Column="6" Content="Read" FontWeight="SemiBold" Command="{Binding ReadCommand}" IsDefault="True" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="RrLabel1" />
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="RrLabel2" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="Address Base" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AddressBases}" SelectedItem="{Binding SelectedAddressBase}" />
                    <Label Grid.Column="2" Content="Default Scale"
                           ToolTip="Scale for registers that have no scale of their own yet (registers defined by the device profile always use the document scale)." />
                    <controls:HistoryField Grid.Column="3" History="{Binding DefaultScaleHistory}">
                        <TextBox Text="{Binding DefaultScaleText, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:HistoryField>
                    <Button Grid.Column="4" Content="Apply to all rows" Command="{Binding ApplyDefaultScaleCommand}"
                            ToolTip="Overwrite the Scale of every manually scaled row with Default Scale (rows defined by the device profile are not changed)." />
                    <!-- No PASS/FAIL text here: every result (PASS, response time, failure reason) is in the Communication Log. -->
                    <Label Grid.Column="5" Content="Device Profile"
                           ToolTip="Generic Modbus: raw value × manual scale. A device profile decodes the registers it defines from the device document." />
                    <ComboBox Grid.Column="6" Width="220"
                              ItemsSource="{Binding DeviceProfiles}" SelectedItem="{Binding SelectedDeviceProfile}"
                              DisplayMemberPath="Name" ToolTip="{Binding SelectedDeviceProfile.Description}" />
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ===== Register Write (Phase 4C) =====
             Follows the Device Profile: a profile lists its writable registers (FC06 only, engineering value / state);
             Generic writes raw words with FC06 / FC16 at an Address in the current Address Base. Every preview,
             validation message and hold reason comes from the Core (ProfileWriteService / RegisterWriteEncoder). -->
        <GroupBox Grid.Row="2" Header="Register Write" IsEnabled="{Binding HasConnectionType}">
            <Grid x:Name="WriteArea" DataContext="{Binding Write}">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel x:Name="WriteRow" Orientation="Horizontal">
                    <Label Content="Function" />
                    <ComboBox x:Name="ProfileWriteFunction" Width="205" ItemsSource="{Binding ProfileFunctions}"
                              SelectedItem="{Binding ProfileFunction, Mode=OneWay}" IsEnabled="False"
                              ToolTip="Device profile writes use FC06 only."
                              Visibility="{Binding IsProfileMode, Converter={StaticResource BoolToVisibility}}" />
                    <ComboBox x:Name="GenericWriteFunction" Width="205" ItemsSource="{Binding GenericFunctions}"
                              SelectedItem="{Binding SelectedGenericFunction}"
                              Visibility="{Binding IsGenericMode, Converter={StaticResource BoolToVisibility}}" />

                    <Label Content="Register" Visibility="{Binding IsProfileMode, Converter={StaticResource BoolToVisibility}}" />
                    <ComboBox x:Name="WriteRegister" Width="200" ItemsSource="{Binding WritableRegisters}"
                              SelectedItem="{Binding SelectedRegister}" DisplayMemberPath="Text"
                              Visibility="{Binding IsProfileMode, Converter={StaticResource BoolToVisibility}}" />
                    <Label Content="Address" Visibility="{Binding IsGenericMode, Converter={StaticResource BoolToVisibility}}"
                           ToolTip="Start address in the current Address Base (see Register Read)." />
                    <TextBox x:Name="WriteAddress" Width="80" Text="{Binding GenericAddressText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsGenericMode, Converter={StaticResource BoolToVisibility}}" />

                    <Label Content="{Binding ValueLabel}" />
                    <TextBox x:Name="WriteValue" Width="110" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding HasRegister}"
                             Visibility="{Binding ShowNumericInput, Converter={StaticResource BoolToVisibility}}" />
                    <ComboBox x:Name="WriteState" Width="110" ItemsSource="{Binding StateOptions}" SelectedItem="{Binding SelectedState}"
                              Visibility="{Binding ShowStateInput, Converter={StaticResource BoolToVisibility}}" />
                    <TextBox x:Name="WriteRawValues" Width="200" Text="{Binding GenericValuesText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Decimal 0~65535 or hex 0x0000~0xFFFF; FC16: comma-separated, e.g. 15,25,0x0096 (Quantity = number of values)."
                             Visibility="{Binding IsGenericMode, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding UnitText}" VerticalAlignment="Center" Margin="0,0,4,0" MinWidth="30" />

                    <Button x:Name="WriteButton" Content="Write" FontWeight="SemiBold" Command="{Binding WriteCommand}" />
                    <Button x:Name="ResetToDefaultButton" Content="Reset to Default" Command="{Binding ResetToDefaultCommand}"
                            ToolTip="Put the document default into the input. Nothing is sent until Write is confirmed."
                            Visibility="{Binding IsProfileMode, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Metadata, preview (Core result) and status -->
                <WrapPanel Grid.Row="1" Margin="4,2">
                    <TextBlock Margin="0,0,16,0" Visibility="{Binding HasRegister, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="Range" Foreground="Gray" /> <Run Text="{Binding RangeText, Mode=OneWay}" />
                        <Run Text="  Scale" Foreground="Gray" /> <Run Text="{Binding ScaleText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Name="WritePreview" FontFamily="Consolas" Margin="0,0,16,0"
                               Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="Value" Foreground="Gray" /> <Run Text="{Binding PreviewEngineering, Mode=OneWay}" />
                        <Run Text="  Qty" Foreground="Gray" /> <Run Text="{Binding PreviewQuantity, Mode=OneWay}" />
                        <Run Text="  Raw" Foreground="Gray" /> <Run Text="{Binding PreviewRaw, Mode=OneWay}" />
                        <Run Text="  HEX" Foreground="Gray" /> <Run Text="{Binding PreviewHex, Mode=OneWay}" />
                        <Run Text="  PDU" Foreground="Gray" /> <Run Text="{Binding PreviewPdu, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock x:Name="WriteStatusText" Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:WriteStatus.Completed}">
                                        <Setter Property="Foreground" Value="ForestGreen" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:WriteStatus.ValidationError}">
                                        <Setter Property="Foreground" Value="Firebrick" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:WriteStatus.WriteFailed}">
                                        <Setter Property="Foreground" Value="Firebrick" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:WriteStatus.VerificationMismatch}">
                                        <Setter Property="Foreground" Value="Firebrick" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:WriteStatus.VerificationFailed}">
                                        <Setter Property="Foreground" Value="Firebrick" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:WriteStatus.WriteOnHold}">
                                        <Setter Property="Foreground" Value="DarkOrange" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="WriteValidationMessage" Text="{Binding ValidationMessage}" Foreground="Firebrick" Margin="0,0,10,0" />
                    <TextBlock x:Name="WriteHoldReason" Text="{Binding HoldReason}" Foreground="DarkOrange" TextWrapping="Wrap"
                               Visibility="{Binding IsOnHold, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
            </Grid>
        </GroupBox>

        <!-- ===== Result ===== -->
        <GroupBox Grid.Row="3" Header="Registers (Scale is editable unless the device profile defines it)">
            <DataGrid x:Name="RegistersGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                      FontFamily="Consolas" BeginningEdit="RegistersGrid_BeginningEdit">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" IsReadOnly="True" Width="65" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="185">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding ChineseDescription}" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Raw" Binding="{Binding Raw}" IsReadOnly="True" Width="65" />
                    <DataGridTextColumn Header="Decimal" Binding="{Binding Decimal}" IsReadOnly="True" Width="70" />
                    <DataGridTextColumn Header="HEX" Binding="{Binding Hex}" IsReadOnly="True" Width="50" />
                    <DataGridTextColumn Header="Binary" Binding="{Binding Binary}" IsReadOnly="True" Width="165" />
                    <!-- Profile-defined rows: document scale ("-" for status registers), grey and not editable. -->
                    <DataGridTextColumn x:Name="ScaleColumn" Header="Scale" Width="60"
                                        Binding="{Binding ScaleText, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScaleEditable}" Value="False">
                                        <Setter Property="Foreground" Value="Gray" />
                                        <Setter Property="FontStyle" Value="Italic" />
                                        <Setter Property="ToolTip" Value="Defined by the device profile (not editable)" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" IsReadOnly="True" Width="*" FontWeight="Bold">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Quality}" Value="{x:Static models:RegisterQuality.OutOfRange}">
                                        <Setter Property="Foreground" Value="Firebrick" />
                                        <Setter Property="ToolTip" Value="Outside the range in the device document (the read itself succeeded)" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Quality}" Value="{x:Static models:RegisterQuality.UnknownState}">
                                        <Setter Property="Foreground" Value="Firebrick" />
                                        <Setter Property="ToolTip" Value="Value not defined in the device document" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="55" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GridSplitter Grid.Row="4" HorizontalAlignment="Stretch" Background="#DDD" />

        <!-- ===== Log ===== -->
        <GroupBox Grid.Row="5">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Communication Log" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="Clear" Command="{Binding ClearLogCommand}" MinWidth="60" Padding="8,1" />
                    <Button Content="Copy" Command="{Binding CopyLogCommand}" MinWidth="60" Padding="8,1" />
                </StackPanel>
            </GroupBox.Header>
            <ListBox x:Name="LogList" ItemsSource="{Binding LogEntries}" FontFamily="Consolas" FontSize="12"
                     VirtualizingPanel.IsVirtualizing="True" SelectionMode="Extended">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:LogEntry">
                        <TextBlock Text="{Binding}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogKind.Tx}">
                                            <Setter Property="Foreground" Value="RoyalBlue" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogKind.Rx}">
                                            <Setter Property="Foreground" Value="DarkCyan" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogKind.Pass}">
                                            <Setter Property="Foreground" Value="ForestGreen" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogKind.Fail}">
                                            <Setter Property="Foreground" Value="Firebrick" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogKind.Error}">
                                            <Setter Property="Foreground" Value="Firebrick" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
    </Grid>
</Window>